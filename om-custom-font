#!/bin/bash

set -e

FONTS_DIR="$HOME/.local/share/fonts"
BACKUP_DIR="$HOME/.config/om-custom-font/backups"

# Omarchy 4 owns the monospace default in /etc/fonts/conf.d/50-omarchy.conf and
# writes the *user* override at ~/.config/fontconfig/fonts.conf from
# omarchy-font-set. We never write that file ourselves — we only ever call
# omarchy-font-set and, on reset, remove the override so the packaged default
# takes over again.
FONTCONFIG_USER="$HOME/.config/fontconfig/fonts.conf"
OMARCHY_DEFAULT_FONT="JetBrainsMono Nerd Font"

usage() {
  cat <<EOF
om-custom-font - Install custom fonts with full Omarchy 4 integration

Usage:
  om-custom-font set <path> [options]        Install font and set as default
  om-custom-font add <path>                  Install font without setting as default
  om-custom-font reset-all                   Reset to Omarchy defaults
  om-custom-font revert-gnome                Restore previous GNOME/GTK font settings
  om-custom-font current                     Show current font across all systems
  om-custom-font help                        Show this help

Arguments:
  <path>    Can be either:
            - A single .ttf/.otf file (variable fonts work fully, traditional
              fonts will use synthetic bold/italic)
            - A directory containing font files (installs all, picks common family)

Options for 'set':
  --gnome             Update both GTK font-name and monospace-font-name
  --gnome-font        Update only GTK font-name (UI elements)
  --gnome-mono        Update only GTK monospace-font-name (code/terminal in GTK apps)

  The --gnome* flags change the font FAMILY only; the existing point size is
  kept. Each creates a timestamped backup first — use 'revert-gnome' to restore.

Font size:
  This tool never sets font size. Omarchy 4 owns it through a single knob that
  moves the shell, GTK, and terminals together:

    omarchy display text size          # show current
    omarchy display text size 16       # set (9-20 px)
    omarchy display text size reset    # back to 12px / 1.0 / 9pt

Examples:
  om-custom-font add ~/Downloads/CascadiaCode.ttf        # just install
  om-custom-font set ~/Downloads/CascadiaCode.ttf        # install + set default
  om-custom-font set ~/MyFontFamily/                     # directory with family
  om-custom-font set ~/Downloads/Font.ttf --gnome
  om-custom-font reset-all                               # back to Omarchy defaults
  om-custom-font revert-gnome
EOF
}

require_omarchy() {
  if ! command -v omarchy-font-set >/dev/null 2>&1; then
    echo "Error: omarchy-font-set not found. This tool requires Omarchy." >&2
    exit 1
  fi

  # Omarchy 4 replaced waybar/walker/swayosd/hyprlock with the Quickshell-based
  # omarchy shell and moved the tree to /usr/share/omarchy. Warn (don't block)
  # if we're clearly on an older layout.
  local version=""
  [[ -r /usr/share/omarchy/version ]] && version=$(< /usr/share/omarchy/version)
  if [[ -z "$version" ]]; then
    echo "Warning: could not read /usr/share/omarchy/version."
    echo "         This version of om-custom-font targets Omarchy 4."
    echo ""
  elif [[ "${version%%.*}" -lt 4 ]] 2>/dev/null; then
    echo "Warning: detected Omarchy $version. This tool targets Omarchy 4."
    echo ""
  fi
}

get_font_family() {
  local ttf_file="$1"
  fc-query -f '%{family[0]}\n' "$ttf_file" | head -n1
}

# Get font info (styles) from fc-scan - caches result to avoid repeated calls
# Returns: style count and comma-separated style list
get_font_info() {
  local ttf_file="$1"
  local scan_output
  scan_output=$(fc-scan "$ttf_file" 2>/dev/null)

  local style_count
  style_count=$(echo "$scan_output" | grep -c "style:" || echo "0")

  local styles
  styles=$(echo "$scan_output" | awk -F'"' '/style:/{printf "%s%s", sep, $2; sep=", "}')

  echo "$style_count|$styles"
}

# `omarchy font list` is `fc-list :spacing=100`, so a proportional family is
# settable but will never show up in the Omarchy font menu.
is_monospace_family() {
  local family="$1"
  fc-list :spacing=100 -f '%{family[0]}\n' 2>/dev/null | grep -Fxq "$family"
}

# Current point size from a gsettings font string ("Adwaita Sans 11" -> 11).
gnome_current_size() {
  local key="$1" name pt
  name=$(gsettings get org.gnome.desktop.interface "$key" 2>/dev/null) || return 0
  name="${name//\'/}"
  pt="${name##* }"
  if [[ "$pt" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "$pt"
  else
    echo "11"
  fi
}

backup_gnome_settings() {
  mkdir -p "$BACKUP_DIR"
  local timestamp
  timestamp=$(date +%Y%m%d-%H%M%S)
  local backup_file="$BACKUP_DIR/$timestamp"

  {
    echo "timestamp=$timestamp"
    echo "font-name=$(gsettings get org.gnome.desktop.interface font-name)"
    echo "monospace-font-name=$(gsettings get org.gnome.desktop.interface monospace-font-name)"
  } > "$backup_file"
  echo "Backed up GNOME font settings to $backup_file"
}

set_gnome_font() {
  local font_name="$1"
  local size="$2"
  gsettings set org.gnome.desktop.interface font-name "$font_name $size"
  echo "Set GNOME/GTK font-name to: $font_name $size"
}

set_gnome_mono() {
  local font_name="$1"
  local size="$2"
  gsettings set org.gnome.desktop.interface monospace-font-name "$font_name $size"
  echo "Set GNOME/GTK monospace-font-name to: $font_name $size"
}

revert_gnome() {
  if [[ ! -d "$BACKUP_DIR" ]] || [[ -z "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]]; then
    echo "Error: No backups found in $BACKUP_DIR"
    echo "Run 'om-custom-font set <file> --gnome' first to create a backup."
    exit 1
  fi

  # List available backups
  echo "Available backups:"
  echo ""

  local backups=()
  local i=1
  while IFS= read -r backup_file; do
    backups+=("$backup_file")
    local ts font mono
    ts=$(basename "$backup_file")
    font=$(grep "^font-name=" "$backup_file" | cut -d= -f2-)
    mono=$(grep "^monospace-font-name=" "$backup_file" | cut -d= -f2-)
    printf "  %d) %s\n" "$i" "$ts"
    printf "     font-name: %s\n" "$font"
    printf "     monospace: %s\n" "$mono"
    echo ""
    i=$((i + 1))
  done < <(ls -1t "$BACKUP_DIR"/*)

  read -rp "Select backup to restore (1-$((i-1))) or 'q' to quit: " choice

  if [[ "$choice" == "q" ]]; then
    echo "Cancelled."
    exit 0
  fi

  if ! [[ "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -lt 1 ]] || [[ "$choice" -gt $((i-1)) ]]; then
    echo "Invalid selection."
    exit 1
  fi

  local selected="${backups[$((choice-1))]}"

  local font_name monospace_font_name
  font_name=$(grep "^font-name=" "$selected" | cut -d= -f2-)
  monospace_font_name=$(grep "^monospace-font-name=" "$selected" | cut -d= -f2-)

  # Remove surrounding quotes from gsettings output
  font_name="${font_name//\'/}"
  monospace_font_name="${monospace_font_name//\'/}"

  echo ""
  echo "Restoring from $(basename "$selected")..."
  gsettings set org.gnome.desktop.interface font-name "$font_name"
  gsettings set org.gnome.desktop.interface monospace-font-name "$monospace_font_name"

  echo "Reverted GNOME font settings:"
  echo "  font-name: $font_name"
  echo "  monospace-font-name: $monospace_font_name"

  # text-scaling-factor is deliberately not restored: it is one third of
  # omarchy-display-text-size's three-way knob (shell base-size / GTK factor /
  # terminal pt). Restoring it alone would desync the other two. Use
  # 'omarchy display text size' to change size.
}

# Family named by the user's fontconfig override, if any.
fontconfig_override_family() {
  [[ -f "$FONTCONFIG_USER" ]] || return 0
  grep -A2 'name="family"' "$FONTCONFIG_USER" 2>/dev/null |
    grep -oP '<string>\K[^<]+' | tail -1
}

# Omarchy 3 wrote a full fonts.conf using mode="assign". On Omarchy 4 the
# package-owned /etc/fonts/conf.d/50-omarchy.conf already assigns monospace, so
# a stale assign-style user rule never matches and is silently ignored — the
# terminals and GTK show the custom font while `fc-match monospace` still
# resolves to the Omarchy default. Omarchy 4 uses prepend_first, which wins.
fontconfig_override_is_stale() {
  [[ -f "$FONTCONFIG_USER" ]] || return 1
  ! grep -q 'mode="prepend_first"' "$FONTCONFIG_USER" 2>/dev/null
}

terminal_font_line() {
  local label="$1" file="$2" pattern="$3"
  [[ -f "$file" ]] || return 0
  printf "  %-22s %s\n" "$label" "$(grep -oP "$pattern" "$file" 2>/dev/null | head -1 || echo 'not set')"
}

show_current() {
  echo "=== Monospace (fontconfig) ==="
  echo ""
  local resolved override
  resolved=$(omarchy-font-current 2>/dev/null || echo 'unknown')
  override=$(fontconfig_override_family)

  printf "  %-22s %s\n" "Resolved:" "$resolved"
  if [[ -z "$override" ]]; then
    printf "  %-22s %s\n" "User override:" "none (using /etc/fonts/conf.d/50-omarchy.conf)"
  elif fontconfig_override_is_stale; then
    printf "  %-22s %s\n" "User override:" "$override  [STALE - Omarchy 3 format]"
    echo ""
    echo "  Warning: $FONTCONFIG_USER predates Omarchy 4 and is being ignored."
    echo "           Fix it by re-applying the font:"
    echo "             omarchy font set \"$override\""
    echo "           or reset with: om-custom-font reset-all"
  else
    printf "  %-22s %s\n" "User override:" "$override"
    if [[ "$override" != "$resolved" ]]; then
      echo ""
      echo "  Warning: override does not match the resolved font."
      echo "           Run 'fc-cache -f' or re-apply with 'omarchy font set'."
    fi
  fi

  echo ""
  echo "=== Terminals ==="
  echo ""
  terminal_font_line "Ghostty:"   ~/.config/ghostty/config         'font-family = "\K[^"]+'
  terminal_font_line "Alacritty:" ~/.config/alacritty/alacritty.toml 'family = "\K[^"]+'
  terminal_font_line "Kitty:"     ~/.config/kitty/kitty.conf       '^font_family \K.+'
  terminal_font_line "Foot:"      ~/.config/foot/foot.ini          '^font=\K[^:]+'

  echo ""
  echo "=== GNOME/GTK ==="
  echo ""
  # Single gsettings call for all values
  local gnome_settings
  gnome_settings=$(gsettings list-recursively org.gnome.desktop.interface 2>/dev/null)
  printf "  %-22s %s\n" "font-name:" \
    "$(echo "$gnome_settings" | awk '$2=="font-name"{for(i=3;i<=NF;i++) printf "%s ", $i; print ""}')"
  printf "  %-22s %s\n" "monospace-font-name:" \
    "$(echo "$gnome_settings" | awk '$2=="monospace-font-name"{for(i=3;i<=NF;i++) printf "%s ", $i; print ""}')"
  printf "  %-22s %s\n" "text-scaling-factor:" \
    "$(echo "$gnome_settings" | awk '$2=="text-scaling-factor"{print $3}')"

  echo ""
  echo "=== Text size (omarchy display text size) ==="
  echo ""
  if command -v omarchy-display-text-size >/dev/null 2>&1; then
    omarchy-display-text-size | sed 's/^/  /'
  else
    echo "  omarchy-display-text-size not available"
  fi
}

cmd_set() {
  install_and_apply "$@"
}

cmd_add() {
  install_and_apply --add-only "$@"
}

cmd_reset_all() {
  echo "Resetting to Omarchy defaults..."
  echo ""

  # Remove custom fonts from user directory
  local custom_fonts
  shopt -s nullglob
  custom_fonts=("$FONTS_DIR"/*.ttf "$FONTS_DIR"/*.otf "$FONTS_DIR"/*.TTF "$FONTS_DIR"/*.OTF)
  shopt -u nullglob

  if [[ ${#custom_fonts[@]} -gt 0 ]]; then
    local removed=0
    echo "Removing custom font file(s) from $FONTS_DIR:"
    for f in "${custom_fonts[@]}"; do
      # Omarchy 4 ships its icon font at /usr/share/fonts/omarchy/omarchy.ttf,
      # but Omarchy 3 installs left a copy here. Never remove it either way.
      if [[ "$(basename "$f")" == "omarchy.ttf" ]]; then
        continue
      fi
      echo "  Removing: $(basename "$f")"
      rm -f "$f"
      removed=$((removed + 1))
    done
    if [[ $removed -eq 0 ]]; then
      echo "  (no custom fonts to remove)"
    fi
    echo ""
    echo "Updating font cache..."
    fc-cache -f
    echo ""
  fi

  # Point every consumer (terminals, fontconfig, shell) back at the default,
  # then drop the user override entirely so the packaged default owns it again.
  echo "Setting Omarchy font to: $OMARCHY_DEFAULT_FONT"
  apply_omarchy_font "$OMARCHY_DEFAULT_FONT"

  if [[ -f "$FONTCONFIG_USER" ]]; then
    echo "Removing user fontconfig override: $FONTCONFIG_USER"
    rm -f "$FONTCONFIG_USER"
    command -v omarchy-restart-shell >/dev/null 2>&1 && omarchy-restart-shell >/dev/null 2>&1 || true
  fi

  # Reset GNOME settings to their schema defaults rather than hardcoding
  # values — Omarchy 4 never sets these itself.
  echo "Resetting GNOME font-name and monospace-font-name to schema defaults"
  gsettings reset org.gnome.desktop.interface font-name
  gsettings reset org.gnome.desktop.interface monospace-font-name

  echo ""
  echo "Done! Reset to Omarchy defaults."
  echo ""
  echo "Note: text size is separate. To reset it too:"
  echo "      omarchy display text size reset"
  echo ""
  show_current
}

# omarchy-font-set prints its errors on stdout and pgrep noise along with them,
# so capture and only surface output when it actually fails.
apply_omarchy_font() {
  local family="$1" out
  if ! out=$(omarchy-font-set "$family" 2>&1); then
    echo "Error: omarchy-font-set failed:" >&2
    echo "$out" >&2
    exit 1
  fi
}

install_and_apply() {
  local font_path=""
  local do_gnome_font=false
  local do_gnome_mono=false
  local add_only=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --add-only)
        add_only=true
        shift
        ;;
      --gnome)
        do_gnome_font=true
        do_gnome_mono=true
        shift
        ;;
      --gnome-font)
        do_gnome_font=true
        shift
        ;;
      --gnome-mono)
        do_gnome_mono=true
        shift
        ;;
      --gnome-size=*)
        echo "Error: --gnome-size was removed." >&2
        echo "       Omarchy 4 owns font size: omarchy display text size <9-20>" >&2
        exit 1
        ;;
      *)
        font_path="$1"
        shift
        ;;
    esac
  done

  if [[ -z "$font_path" ]]; then
    echo "Error: No font file or directory specified"
    usage
    exit 1
  fi

  local font_family=""
  local installed_count=0

  mkdir -p "$FONTS_DIR"

  if [[ -d "$font_path" ]]; then
    # Directory mode: install all font files
    echo "Directory detected: $font_path"
    echo ""

    # Single pass: collect families and counts using associative array
    declare -A family_counts
    local families=()

    shopt -s nullglob
    for f in "$font_path"/*.ttf "$font_path"/*.otf "$font_path"/*.TTF "$font_path"/*.OTF; do
      [[ -f "$f" ]] || continue

      local fam
      fam=$(get_font_family "$f")
      if [[ -n "$fam" ]]; then
        # Track count per family
        if [[ -z "${family_counts[$fam]:-}" ]]; then
          family_counts[$fam]=0
          families+=("$fam")
        fi
        family_counts[$fam]=$((family_counts[$fam] + 1))
      fi

      cp "$f" "$FONTS_DIR/"
      echo "  Installed: $(basename "$f")"
      installed_count=$((installed_count + 1))
    done
    shopt -u nullglob

    if [[ $installed_count -eq 0 ]]; then
      echo "Error: No .ttf or .otf files found in $font_path"
      exit 1
    fi

    echo ""
    echo "Installed $installed_count font files."

    # Handle multiple families
    if [[ ${#families[@]} -eq 1 ]]; then
      font_family="${families[0]}"
      echo "Font family: $font_family"
    elif [[ ${#families[@]} -gt 1 ]]; then
      echo ""
      echo "Multiple font families found:"
      local i=1
      for fam in "${families[@]}"; do
        printf "  %d) %s (%d files)\n" "$i" "$fam" "${family_counts[$fam]}"
        i=$((i + 1))
      done
      echo ""
      read -rp "Select family to set as default (1-${#families[@]}): " choice

      if ! [[ "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -lt 1 ]] || [[ "$choice" -gt ${#families[@]} ]]; then
        echo "Invalid selection. Using first family."
        font_family="${families[0]}"
      else
        font_family="${families[$((choice-1))]}"
      fi
    fi

  elif [[ -f "$font_path" ]]; then
    # Single file mode
    local ttf_file="$font_path"

    font_family=$(get_font_family "$ttf_file")
    if [[ -z "$font_family" ]]; then
      echo "Error: Could not determine font family from $ttf_file"
      exit 1
    fi

    echo "Font family detected: $font_family"

    # Check if it's a variable font (single fc-scan call for both count and styles)
    local font_info style_count styles
    font_info=$(get_font_info "$ttf_file")
    style_count="${font_info%%|*}"
    styles="${font_info#*|}"

    if [[ "$style_count" -gt 1 ]]; then
      echo "Variable font detected with styles: $styles"
      echo ""
    else
      # Traditional single-weight font - check if there are siblings
      local dir sibling_count
      dir=$(dirname "$ttf_file")

      # Count siblings in one pass (only spawn fc-query for files that exist)
      sibling_count=0
      shopt -s nullglob
      for f in "$dir"/*.ttf "$dir"/*.otf "$dir"/*.TTF "$dir"/*.OTF; do
        [[ -f "$f" ]] || continue
        if [[ "$(get_font_family "$f")" == "$font_family" ]]; then
          sibling_count=$((sibling_count + 1))
        fi
      done
      shopt -u nullglob

      if [[ "$sibling_count" -gt 1 ]]; then
        echo ""
        echo "Warning: This is a traditional (non-variable) font file."
        echo "         Found $sibling_count files for '$font_family' in the same directory."
        echo "         Bold/italic will be synthesized (may look poor)."
        echo ""
        echo "Tip: Run with the directory instead to install the full family:"
        echo "     om-custom-font set \"$dir\""
        echo ""
        read -rp "Continue with single file anyway? [y/N] " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
          echo "Cancelled."
          exit 0
        fi
      else
        echo ""
        echo "Note: Single font file. Bold/italic will be synthesized by the renderer."
      fi
    fi

    cp "$ttf_file" "$FONTS_DIR/"
    echo "Installed $(basename "$ttf_file") to $FONTS_DIR/"
    installed_count=1

  else
    echo "Error: Path not found: $font_path"
    exit 1
  fi

  # Update font cache
  echo ""
  echo "Updating font cache..."
  fc-cache -f

  # Verify font is now available
  if ! fc-list "$font_family" 2>/dev/null | grep -q .; then
    echo "Warning: Font may not have installed correctly. Check fc-list output."
  fi

  if ! is_monospace_family "$font_family"; then
    echo ""
    echo "Note: '$font_family' is not a monospace family, so it will not appear"
    echo "      in 'omarchy font list' (which filters on fc-list :spacing=100)."
    echo "      It can still be set explicitly, and works fine for GTK UI text."
  fi

  if $add_only; then
    echo ""
    echo "Done! Font '$font_family' added to system."
    if is_monospace_family "$font_family"; then
      echo "It will now appear in 'omarchy font list' and the Omarchy font menu."
    fi
    return
  fi

  # omarchy-font-set updates the terminals, rewrites the user fontconfig
  # override, restarts the omarchy shell, and fires the `font-set` hook.
  echo "Setting Omarchy font..."
  apply_omarchy_font "$font_family"

  # Handle GNOME/GTK settings
  if $do_gnome_font || $do_gnome_mono; then
    # Family only. The point size is carried over untouched because
    # omarchy-display-text-size quantizes text-scaling-factor against the
    # font-name point size — writing it here would desync that knob.
    backup_gnome_settings
    if $do_gnome_font; then
      set_gnome_font "$font_family" "$(gnome_current_size font-name)"
    fi
    if $do_gnome_mono; then
      set_gnome_mono "$font_family" "$(gnome_current_size monospace-font-name)"
    fi
  else
    echo ""
    echo "Tip: Add --gnome, --gnome-font, or --gnome-mono to also update GTK app fonts"
  fi

  echo ""
  echo "Done! Font '$font_family' is now set."
  echo ""
  echo "Note: Ghostty and Foot need a restart to pick up a family change."
}

# Main command dispatch
case "${1:-}" in
  set)
    require_omarchy
    shift
    cmd_set "$@"
    ;;
  add)
    require_omarchy
    shift
    cmd_add "$@"
    ;;
  reset-all)
    require_omarchy
    cmd_reset_all
    ;;
  revert-gnome)
    revert_gnome
    ;;
  current)
    show_current
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
